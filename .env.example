# Database Connection
# Replace with your actual MongoDB Atlas connection string from Cluster0:
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/chefora?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/chefora?retryWrites=true&w=majority

# JWT Authentication Secret Key (Any random secure string)
JWT_SECRET=your-secure-jwt-secret-key-here

# External AI & Recipe APIs
COHERE_API_KEY=your-cohere-api-key-here
SPOONACULAR_API_KEY=your-spoonacular-api-key-here
API_NINJAS_KEY=your-api-ninjas-key-here
